{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurboDiff",
  "version": "0.2.0",
  "identifier": "com.albertoventurini.turbodiff",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "publisher": "Alberto Venturini",
    "copyright": "© 2026 Alberto Venturini",
    "category": "DeveloperTool",
    "shortDescription": "A read-only desktop viewer for git diffs",
    "longDescription": "TurboDiff shows the changes in a git repository the way GitHub's \"Files changed\" view does: the working tree against HEAD, or any two branches, tags or commits. It never writes to the repository.",
    "homepage": "https://github.com/albertoventurini/turbodiff",
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
